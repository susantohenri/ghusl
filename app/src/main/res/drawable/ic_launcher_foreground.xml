<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drop Soft Shadow -->
    <path
        android:fillColor="#25000000"
        android:pathData="M 54,27 C 54,27 74,49 74,62 C 74,72.5 65.5,82 54,82 C 42.5,82 34,72.5 34,62 C 34,49 54,27 54,27 Z" />

    <!-- Main Water Droplet with Water Gradient -->
    <path android:pathData="M 54,25 C 54,25 73,47 73,60 C 73,70.5 64.5,79 54,79 C 43.5,79 35,70.5 35,60 C 35,47 54,25 54,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="35"
                android:startY="25"
                android:endX="73"
                android:endY="79"
                android:type="linear">
                <item android:color="#FFE0F7FA" android:offset="0.0" />
                <item android:color="#FFBDE0E8" android:offset="0.3" />
                <item android:color="#FF5C9EAD" android:offset="0.75" />
                <item android:color="#FF2E7D5F" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Droplet Ring Accent -->
    <path
        android:pathData="M 54,25 C 54,25 73,47 73,60 C 73,70.5 64.5,79 54,79 C 43.5,79 35,70.5 35,60 C 35,47 54,25 54,25 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#A0FFFFFF" />

    <!-- Crescent Moon (Hilal) symbolizing Islam inside the droplet -->
    <path
        android:pathData="M 52,36 C 43,40 38,49 38,59 C 38,69 45,76 54,76 C 48,74 43,67 43,58 C 43,49 48,41 55,38 C 54,37 53,36 52,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="36"
                android:endX="55"
                android:endY="76"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#FFF5F7FA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Star (Islamic 8-pointed Rub el Hizb) near Moon Crescent -->
    <path
        android:fillColor="#FFFFD700"
        android:pathData="M 61,42 L 62.5,44.5 L 65,43 L 64.5,45.5 L 67,47 L 64.5,48.5 L 65,51 L 62.5,49.5 L 61,52 L 59.5,49.5 L 57,51 L 57.5,48.5 L 55,47 L 57.5,45.5 L 57,43 L 59.5,44.5 Z" />

    <!-- Pure Water Waves / Flow Lines inside Droplet -->
    <path
        android:pathData="M 44,65 C 50,68 58,68 64,65"
        android:strokeWidth="2"
        android:strokeColor="#D0FFFFFF"
        android:strokeLineCap="round" />

    <path
        android:pathData="M 47,70 C 51,72 56,72 60,70"
        android:strokeWidth="1.5"
        android:strokeColor="#80E0F7FA"
        android:strokeLineCap="round" />

    <!-- Highlight Shine Curve on top-left of Droplet -->
    <path
        android:pathData="M 50,31 C 45,38 41,47 41,56"
        android:strokeWidth="2.5"
        android:strokeColor="#70FFFFFF"
        android:strokeLineCap="round" />

</vector>
